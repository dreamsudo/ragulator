# Copy this file to ".env" and fill in your key.  The real ".env" is git-ignored.
#
#   cp .env.example .env
#
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# In Google Colab you can instead add it under the key icon (Secrets) as
# GOOGLE_API_KEY and skip this file entirely.

GOOGLE_API_KEY=your-google-api-key-here

# Optional overrides (uncomment to use). These map to Settings fields via CDP_*.
# CDP_NKT_MODE=moderate
# CDP_NUM_DOCUMENTS=1000
# CDP_LOG_LEVEL=INFO
